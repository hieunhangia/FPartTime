# =================================================================
# FPARTTIME ENVIRONMENT CONFIGURATION (.env)
# Sao chép file này thành .env và điền các giá trị thực tế
# =================================================================

# --- MÔI TRƯỜNG CHẠY ---
ASPNETCORE_ENVIRONMENT=Production
TZ=Asia/Ho_Chi_Minh

# --- CƠ SỞ DỮ LIỆU SQL SERVER ---
DB_PASSWORD=YourStrongPassword@2026!

# --- CLOUDFLARE TUNNEL TOKEN (Lấy từ Cloudflare Zero Trust) ---
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# --- TÊN MIỀN & GIAO TIẾP API ---
# URL công khai của Backend API qua Cloudflare Tunnel
BACKEND_API_BASE_URL=https://api.yourdomain.com
# Whitelist host cho Kiota API Client trên Frontend
BACKEND_API_ALLOWED_HOSTS=api.yourdomain.com,localhost,backend

# --- BẢO MẬT JWT AUTHENTICATION ---
JWT_SECRET_KEY=your-secret-key-that-needs-to-be-long-enough
JWT_ISSUER=https://api.yourdomain.com
JWT_AUDIENCE=https://api.yourdomain.com
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15

# --- CLOUDFLARE R2 OBJECT STORAGE ---
R2_SERVICE_URL=https://r2.yourdomain.com
R2_PUBLIC_DOMAIN=https://r2.yourdomain.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_PUBLIC_BUCKET_NAME=your_public_bucket_name
R2_PRIVATE_BUCKET_NAME=your_private_bucket_name
R2_PRESIGNED_GET_EXPIRY_SECONDS=3600

# --- SYSTEM HEALTH CHECK ---
HEALTH_CHECK_HEADER=X-Your-Health-Check-Header
HEALTH_CHECK_API_KEY=your-health-check-secret-key

# --- BETTER STACK UPTIME MONITORING ---
BETTER_STACK_API_TOKEN=your-better-stack-api-token

# --- SENTRY ERROR MONITORING ---
SENTRY_DSN=your_sentry_dsn_here

# --- PayOS ---
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# --- VNPAY ---
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here

