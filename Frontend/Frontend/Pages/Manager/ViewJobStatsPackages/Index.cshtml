@page
@model Frontend.Pages.Manager.ViewJobStatsPackages.IndexModel
@{
    ViewData["Title"] = "Quản lý gói lượt xem";
}

<div class="container my-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Gói lượt xem</h1>
            <p class="text-muted mb-0">Quản lý các gói lượt xem thống kê việc làm dành cho ứng viên.</p>
        </div>
        <a asp-page="./Create" class="btn btn-primary flex-shrink-0">
            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Tạo gói
        </a>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    @if (Model.PackagesLoaded && Model.Packages.Count == 0)
    {
        <div class="alert alert-light border" role="status">Chưa có gói lượt xem nào.</div>
    }
    else if (Model.PackagesLoaded)
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Gói</th>
                        <th>Số lượt xem</th>
                        <th>Giá</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var package in Model.Packages)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@package.Name</div>
                            @if (!string.IsNullOrWhiteSpace(package.Description))
                            {
                                <div class="small text-muted">@package.Description</div>
                            }
                        </td>
                        <td class="text-nowrap">@package.ViewCredits lượt</td>
                        <td class="text-nowrap">@IndexModel.FormatPrice(package.Price)</td>
                        <td>
                            @if (package.IsActive == true)
                            {
                                <span class="badge text-bg-success">Đang cung cấp</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Đã ngừng</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-2">
                                <a asp-page="./Edit" asp-route-id="@package.Id" class="btn btn-sm btn-outline-primary">
                                    @(package.IsActive == true ? "Sửa" : "Sửa / bật lại")
                                </a>
                                @if (package.IsActive == true)
                                {
                                    <form method="post" asp-page-handler="Deactivate" asp-route-id="@package.Id"
                                          onsubmit="return confirm('Ngừng cung cấp gói này cho các lần mua mới?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Ngừng cung cấp</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
