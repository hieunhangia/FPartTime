@page
@model Frontend.Pages.Manager.ViewJobStatsPackages.CreateModel
@{
    ViewData["Title"] = "Tạo gói lượt xem";
}

<div class="container my-4">
    <div class="mb-4">
        <a asp-page="./Index" class="text-decoration-none">← Gói lượt xem</a>
        <h1 class="h2 mt-2 mb-1">Tạo gói lượt xem</h1>
        <p class="text-muted mb-0">Nhập số lượt xem và giá bán cho ứng viên.</p>
    </div>
    <form method="post" class="card shadow-sm">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <partial name="_PackageFields" for="Input" />
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">Hủy</a>
            <button type="submit" class="btn btn-primary">Tạo gói</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
