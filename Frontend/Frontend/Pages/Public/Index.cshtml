@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Tìm việc làm bán thời gian";
}

<div class="my-4">
    <h1 class="h3 mb-3">Tìm việc làm</h1>

    <form method="get" asp-page="/Public/Jobs" class="row g-2 mb-4" role="search">
        <div class="col-md-4">
            <label asp-for="Keyword" class="visually-hidden">Từ khóa tìm việc</label>
            <input asp-for="Keyword" class="form-control" type="search" placeholder="Tìm việc làm..." />
        </div>
        <div class="col-md-3">
            <label asp-for="Province" class="visually-hidden">Khu vực</label>
            <select asp-for="Province" class="form-select">
                <option value="">Tất cả khu vực</option>
                @foreach (var province in Model.Provinces)
                {
                    <option value="@province">@province</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="IndustryId" class="visually-hidden">Ngành nghề</label>
            <select asp-for="IndustryId" class="form-select">
                <option value="">Tất cả ngành nghề</option>
                @foreach (var industry in Model.Industries)
                {
                    <option value="@industry.Id">@industry.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm việc</button>
        </div>
    </form>

    <section class="mb-4" aria-labelledby="popular-industries-title">
        <h2 id="popular-industries-title" class="h5 mb-3">Các ngành nghề phổ biến</h2>
        @if (Model.PopularIndustries.Count == 0)
        {
            <p class="text-muted">Chưa có ngành nghề đang tuyển.</p>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-2">
                @foreach (var industry in Model.PopularIndustries)
                {
                    <div class="col">
                        <a asp-page="/Public/Jobs" asp-route-IndustryId="@industry.Id"
                           class="list-group-item list-group-item-action border rounded p-3 h-100">
                            <span class="d-block fw-semibold">@industry.Name</span>
                            <small class="text-muted">@industry.JobCount việc đang tuyển</small>
                        </a>
                    </div>
                }
            </div>
        }
    </section>

    <a asp-page="/Public/Jobs" class="btn btn-outline-primary">Xem tất cả việc làm</a>
</div>
