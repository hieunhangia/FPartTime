@page "/"
@model IndexModel
@{
    ViewData["Title"] = "Danh sách việc làm";
}

<div class="container my-4">
    <h2 class="mb-3">Danh sách việc làm</h2>

    @if (Model.Jobs.Count == 0)
    {
        <p class="text-muted">Chưa có việc làm nào.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var job in Model.Jobs)
            {
                <a asp-page="/Public/JobDetail" asp-route-id="@job.Id" class="list-group-item list-group-item-action py-3">
                    <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                        <h5 class="mb-0 text-primary">@job.Title</h5>
                        <small class="text-muted">Hạn: @(job.ExpiryAt != null ? $"{job.ExpiryAt.Value.Day:D2}/{job.ExpiryAt.Value.Month:D2}/{job.ExpiryAt.Value.Year}" : "-")</small>
                    </div>
                    <p class="mb-1 text-dark">@(job.EmployerCompanyName ?? "Nhà tuyển dụng")</p>
                    <div class="d-flex w-100 justify-content-between align-items-center flex-wrap gap-2">
                        <small class="text-muted">
                            Địa điểm: @IndexModel.FormatLocation(job) | Lương: @IndexModel.FormatSalariesSummary(job.Salaries)
                        </small>
                        <small class="text-muted">
                            Cập nhật: @(job.UpdatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </small>
                    </div>
                </a>
            }
        </div>
    }
</div>