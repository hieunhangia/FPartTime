@page
@model Frontend.Pages.Candidate.ViewJobStats.CancelModel
@{
    ViewData["Title"] = "Giao dịch đã bị hủy";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm text-center border p-4">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-warning bg-opacity-25 text-warning"
                              style="width: 72px; height: 72px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0M7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                            </svg>
                        </span>
                    </div>

                    <h3 class="card-title fw-bold text-dark mb-2">Giao dịch đã bị hủy</h3>
                    <p class="text-muted mb-4">
                        Quá trình thanh toán gói lượt xem của bạn đã bị hủy hoặc chưa hoàn tất. Tài khoản của bạn chưa bị trừ tiền.
                    </p>

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-page="./BuyCredits" asp-route-returnUrl="@Model.ReturnUrl" class="btn btn-primary px-4">
                            Chọn lại gói lượt xem
                        </a>
                        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                        {
                            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary px-3">
                                Quay lại bài đăng
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
