@page
@model Frontend.Pages.Candidate.ViewJobStats.BuyCreditsModel
@{
    ViewData["Title"] = "Mua lượt xem thống kê bài đăng";
}

<div class="container my-4">
    @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
    {
        <div class="mb-3">
            <a href="@Model.ReturnUrl" class="btn btn-outline-secondary btn-sm">
                &larr; Quay lại bài đăng
            </a>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">Mua lượt xem thống kê ứng tuyển</h3>
        <span class="badge bg-primary fs-6">
            Số dư hiện tại: @Model.CurrentBalance lượt
        </span>
    </div>

    <div class="alert alert-info">
        <div class="fw-bold mb-1">Quyền lợi khi mua lượt xem:</div>
        <ul class="mb-0 ps-3">
            <li>Mỗi lượt mở khóa cho phép xem chi tiết số lượng đơn ứng tuyển (Tổng số, Chờ duyệt, Được chấp nhận, Bị từ chối) tại thời điểm yêu cầu.</li>
            <li>Dữ liệu đã mở khóa sẽ được lưu lại để xem lại bất kỳ lúc nào mà không bị trừ thêm lượt.</li>
            <li>Chỉ khi bạn muốn cập nhật số liệu mới nhất tại thời điểm sau đó, hệ thống mới yêu cầu sử dụng thêm 1 lượt.</li>
        </ul>
    </div>

    <form method="post" asp-page-handler="Checkout">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="card mb-4">
            <div class="card-header bg-white fw-bold">
                1. Chọn gói lượt xem
            </div>
            <div class="card-body">
                @if (Model.Packages.Count == 0)
                {
                    <p class="text-muted mb-0">Hiện tại chưa có gói dịch vụ nào đang mở bán. Vui lòng quay lại sau.</p>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var pkg in Model.Packages)
                        {
                            <div class="col-md-4">
                                <div class="card h-100 border">
                                    <div class="card-body d-flex flex-column">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h5 class="card-title fw-bold mb-0">@pkg.Name</h5>
                                            <span class="badge bg-secondary">@pkg.ViewCredits lượt</span>
                                        </div>
                                        <div class="fs-4 fw-bold text-success mb-2">
                                            @(pkg.Price?.ToString("N0") ?? "0") đ
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(pkg.Description))
                                        {
                                            <p class="text-muted small flex-grow-1">@pkg.Description</p>
                                        }
                                        else
                                        {
                                            <div class="flex-grow-1"></div>
                                        }
                                        <div class="form-check mt-3 pt-2 border-top">
                                            <input class="form-check-input" type="radio" asp-for="Input.PackageId" value="@pkg.Id" id="pkg_@pkg.Id" required />
                                            <label class="form-check-label fw-bold" for="pkg_@pkg.Id">
                                                Chọn gói này
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-white fw-bold">
                2. Chọn phương thức thanh toán
            </div>
            <div class="card-body">
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" asp-for="Input.PaymentMethod" value="PayOS" id="payMethodPayOS" checked />
                    <label class="form-check-label fw-bold" for="payMethodPayOS">
                        Cổng PayOS
                    </label>
                    <div class="text-muted small">Quét mã QR chuyển khoản nhanh qua ứng dụng ngân hàng 24/7.</div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" asp-for="Input.PaymentMethod" value="VNPAY" id="payMethodVNPAY" />
                    <label class="form-check-label fw-bold" for="payMethodVNPAY">
                        Cổng VNPAY
                    </label>
                    <div class="text-muted small">Thẻ ATM nội địa, tài khoản ngân hàng, quét QR hoặc thẻ quốc tế.</div>
                </div>

                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="Input.PaymentMethod" value="ZaloPay" id="payMethodZaloPay" />
                    <label class="form-check-label fw-bold" for="payMethodZaloPay">
                        Ví điện tử ZaloPay
                    </label>
                    <div class="text-muted small">Thanh toán qua ví ZaloPay hoặc ứng dụng ngân hàng liên kết.</div>
                </div>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="submit" class="btn btn-success px-4 py-2" @(Model.Packages.Count == 0 ? "disabled" : "")>
                Tiến hành thanh toán
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
            {
                <a href="@Model.ReturnUrl" class="btn btn-outline-secondary px-3 py-2">Hủy bỏ</a>
            }
        </div>
    </form>
</div>
