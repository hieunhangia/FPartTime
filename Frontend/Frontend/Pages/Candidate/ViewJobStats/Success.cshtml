@page
@model Frontend.Pages.Candidate.ViewJobStats.SuccessModel
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm text-center border p-4">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-25 text-success"
                              style="width: 72px; height: 72px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0m-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                        </span>
                    </div>

                    <h3 class="card-title fw-bold text-success mb-2">Thanh toán thành công!</h3>
                    <p class="text-muted mb-4">
                        Giao dịch mua lượt xem thống kê của bạn đã được xác nhận thành công. Số lượt mở khóa đã được cộng vào tài khoản của bạn.
                    </p>

                    <div class="d-flex justify-content-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
                        {
                            <a href="@Model.ReturnUrl" class="btn btn-primary px-4">
                                Quay lại bài đăng
                            </a>
                        }
                        <a asp-page="./BuyCredits" class="btn btn-outline-secondary px-3">
                            Xem số dư
                        </a>
                        <a asp-page="/Public/Jobs" class="btn btn-outline-secondary px-3">
                            Khám phá việc làm
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
