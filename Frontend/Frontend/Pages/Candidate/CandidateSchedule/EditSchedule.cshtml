@page
@using Frontend.Pages.Candidate.CandidateSchedule
@model Frontend.Pages.Candidate.CandidateSchedule.EditScheduleModel
@{
    ViewData["Title"] = "Đăng ký lịch rảnh";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h2 class="mb-1">Lịch rảnh trong tuần</h2>
                    <p class="text-muted small mb-0">Tích chọn các buổi bạn có thể nhận ca làm việc để nhà tuyển dụng dễ dàng sắp xếp.</p>
                </div>
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form method="post">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white fw-bold py-3">
                        <i class="bi bi-calendar3 me-2 text-primary"></i>Lịch rảnh trong tuần
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover align-middle text-center mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 15%;" class="text-start ps-3">Ca / Buổi</th>
                                        @foreach (var day in EditScheduleModel.DisplayDays)
                                        {
                                            <th style="width: 12%;">@EditScheduleModel.GetDayName(day)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var shift in EditScheduleModel.DisplayShifts)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-start ps-3 bg-light">
                                                @EditScheduleModel.GetShiftName(shift)
                                            </td>
                                            @foreach (var day in EditScheduleModel.DisplayDays)
                                            {
                                                var slotValue = $"{day}:{shift}";
                                                var isChecked = Model.SelectedSlots.Contains(slotValue);

                                                <td>
                                                    <div class="form-check d-flex justify-content-center my-1">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               name="SelectedSlots"
                                                               value="@slotValue"
                                                               id="@slotValue"
                                                        @(isChecked ? "checked" : "") />
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
              
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="./EditSchedules" class="btn btn-outline-secondary px-4">Đặt lại</a>
                    <button type="submit" class="btn btn-primary px-4">Lưu lịch rảnh</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}