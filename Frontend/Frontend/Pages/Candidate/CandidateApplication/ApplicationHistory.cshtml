@page
@using ApiSdk.Models
@model Frontend.Pages.Candidate.CandidateApplication.ApplicationHistoryModel
@{
	ViewData["Title"] = "Lịch sử ứng tuyển của tôi";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Đơn ứng tuyển của tôi</h2>
    </div>
    <!-- Bộ lọc -->
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-md-3">
                    <label asp-for="Keyword" class="form-label fw-bold">Tìm theo tên công việc:</label>
                    <input asp-for="Keyword" class="form-control" placeholder="Nhập tên công việc..." />
                </div>
                <div class="col-md-2">
                    <label asp-for="FromDate" class="form-label fw-bold">Từ ngày:</label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="ToDate" class="form-label fw-bold">Đến ngày:</label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="OrderBy" class="form-label fw-bold">Sắp xếp:</label>
                    <select asp-for="OrderBy" class="form-select">
                        <option value="AppliedAt_Desc">Ngày ứng tuyển (mới nhất)</option>
                        <option value="AppliedAt_Asc">Ngày ứng tuyển (cũ nhất)</option>
                        <option value="JobTitle_Asc">Tên công việc (A - Z)</option>
                        <option value="JobTitle_Desc">Tên công việc (Z - A)</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Lọc</button>
                    <a asp-page="./ApplicationHistory" class="btn btn-outline-secondary">Xóa lọc</a>
                </div>
            </form>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="text-muted mb-0">
            Tìm thấy <strong>@Model.TotalCount</strong> đơn
            (Trang @Model.PageNumber / @Model.TotalPages)
        </p>
    </div>
    @if (Model.Applications.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">
            <p class="mb-0">Bạn chưa có đơn ứng tuyển nào.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle shadow-sm">
                <thead class="table-light">
                    <tr>
                        <th>Tên công việc</th>
                        <th>Trạng thái</th>
                        <th>Ngày ứng tuyển</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Applications)
                    {
                        var (statusLabel, statusCss) = Model.GetStatusDisplay(app.Status);
                        <tr>
                            <td class="fw-bold">@app.JobTitle</td>
                            <td><span class="badge @statusCss">@statusLabel</span></td>
                            <td class="text-nowrap">@(app.AppliedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="./Detail" asp-route-id="@app.Id"
                                   class="btn btn-sm btn-outline-primary me-1">Xem chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 mt-4">
                <nav aria-label="Page navigation">
                    <ul class="pagination mb-0 flex-wrap justify-content-center">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page=". /ApplicationHistory"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-OrderBy="@Model.OrderBy"
                               asp-route-PageNumber="1">« Đầu</a>
                        </li>
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page=". /ApplicationHistory"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-OrderBy="@Model.OrderBy"
                               asp-route-PageNumber="@(Model.PageNumber - 1)">‹ Trước</a>
                        </li>
                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 2 && i <= Model.PageNumber + 2))
                            {
                                var i1 = i;
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-page=". /ApplicationHistory"
                                       asp-route-Keyword="@Model.Keyword"
                                       asp-route-OrderBy="@Model.OrderBy"
                                       asp-route-PageNumber="@i1">@i1</a>
                                </li>
                            }
                            else if (i == Model.PageNumber - 3 || i == Model.PageNumber + 3)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }
                        }
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="./ApplicationHistory"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-OrderBy="@Model.OrderBy"
                               asp-route-PageNumber="@(Model.PageNumber + 1)">Sau ›</a>
                        </li>
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="./ApplicationHistory"
                               asp-route-Keyword="@Model.Keyword"
                               asp-route-OrderBy="@Model.OrderBy"
                               asp-route-PageNumber="@Model.TotalPages">Cuối »</a>
                        </li>
                    </ul>
                </nav>
                <form method="get" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="Keyword" value="@Model.Keyword" />
                    <input type="hidden" name="OrderBy" value="@Model.OrderBy" />
                    <label for="jumpPageNumber" class="text-muted small text-nowrap mb-0">Nhảy đến trang:</label>
                    <input type="number" id="jumpPageNumber" name="PageNumber"
                           min="1" max="@Model.TotalPages" value="@Model.PageNumber"
                           class="form-control form-control-sm text-center" style="width: 70px;" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Đi</button>
                </form>
            </div>
        }
    }
</div>
