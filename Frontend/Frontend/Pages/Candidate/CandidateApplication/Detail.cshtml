@page "{id:guid}"
@using ApiSdk.Models
@model Frontend.Pages.Candidate.CandidateApplication.DetailModel
@{
    ViewData["Title"] = "Chi tiết đơn ứng tuyển";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Chi tiết đơn ứng tuyển</h2>
        </div>
        <a asp-page="./ApplicationHistory" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    @if (Model.Application != null)
    {
        var (statusLabel, statusCss) = Model.GetStatusDisplay(Model.Application.Status);
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-body p-4">
                        <h4 class="card-title text-primary fw-bold mb-3">
                            @(Model.Job?.Title ?? Model.Application.JobTitle)
                        </h4>

                        @if (Model.Job != null)
                        {
                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="text-muted small">Mức lương</div>
                                        <div class="fw-semibold text-danger fs-5">
                                            @(Model.Job.Salaries is { Count: > 0 } ? DetailModel.FormatSalary(Model.Job.Salaries[0]) : "Thỏa thuận")
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 bg-light rounded">
                                        <div class="text-muted small">Địa điểm làm việc</div>
                                        <div class="fw-semibold">
                                            @DetailModel.FormatFullAddress(Model.Job)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h5 class="fw-bold mb-2">Mô tả công việc</h5>
                            <div class="text-muted mb-4" style="white-space: pre-line;">
                                @(string.IsNullOrWhiteSpace(Model.Job.Description) ? "Không có mô tả chi tiết." : Model.Job.Description)
                            </div>

                            <h5 class="fw-bold mb-2">Yêu cầu ứng viên</h5>
                            <ul class="list-unstyled mb-4 ps-1 text-muted">
                                <li class="mb-1">• <strong>Số lượng tuyển:</strong> @(Model.Job.VacancyCount.HasValue ? $"{Model.Job.VacancyCount} người" : "Không giới hạn")</li>
                                <li class="mb-1">• <strong>Độ tuổi:</strong> @DetailModel.FormatAgeRequirement(Model.Job.MinAgeRequirement, Model.Job.MaxAgeRequirement)</li>
                                <li class="mb-1">• <strong>Giới tính:</strong> @DetailModel.FormatGenderRequirement(Model.Job.GenderRequirement)</li>
                            </ul>

                            @if (!string.IsNullOrWhiteSpace(Model.Job.EmployerCompanyName))
                            {
                                <div class="p-3 bg-light rounded">
                                    <div class="text-muted small">Nhà tuyển dụng</div>
                                    <div class="fw-bold text-dark">@Model.Job.EmployerCompanyName</div>
                                    @if (!string.IsNullOrWhiteSpace(Model.Job.EmployerContactPhone))
                                    {
                                        <div class="small text-muted mt-1">SĐT liên hệ: @Model.Job.EmployerContactPhone</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white py-3">
                        <h5 class="card-title mb-0 fw-bold">Thông tin ứng tuyển</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <span class="text-muted d-block small">Trạng thái:</span>
                            <span class="badge @statusCss fs-6 mt-1">@statusLabel</span>
                        </div>

                        <div class="mb-4">
                            <span class="text-muted d-block small">Thời gian ứng tuyển:</span>
                            <span class="fw-semibold">
                                @(Model.Application.AppliedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                            </span>
                        </div>

                        <hr />

                        @if (Model.Application.Status == JobApplicationStatus.Pending)
                        {
                            <div class="alert alert-warning small mb-3">
                                Bạn có thể hủy đơn ứng tuyển này nếu công việc không còn phù hợp.
                            </div>
                            <form method="post" asp-page-handler="Withdraw" asp-route-id="@Model.Application.Id"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn ứng tuyển này? Thao tác không thể hoàn tác.');">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="bi bi-x-circle me-1"></i> Hủy đơn ứng tuyển
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-secondary small mb-0">
                                Đơn ứng tuyển đã được xử lý nên không thể hủy.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>