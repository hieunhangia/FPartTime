@page
@model EditProfileModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h2 class="mb-3">Chỉnh sửa hồ sơ</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (Model.OpenForJobStatus != null)
            {
                <partial name="_OpenForJobStatusBanner" model="Model.OpenForJobStatus" />
            }

            <form method="post" enctype="multipart/form-data">
                <div class="card mb-4">
                    <div class="card-header fw-bold">Ảnh đại diện</div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                        {
                            <img src="@Model.CurrentAvatarUrl" class="rounded-circle mb-3"
                                 style="width:80px;height:80px;object-fit:cover;" alt="Avatar" />
                        }
                        <div class="mb-3">
                            <label asp-for="Input.AvatarFile" class="form-label">Chọn ảnh mới</label>
                            <input asp-for="Input.AvatarFile" class="form-control" accept=".jpg,.jpeg,.png" />
                            <div class="form-text">JPG, JPEG hoặc PNG. Tối đa 5MB.</div>
                            <span asp-validation-for="Input.AvatarFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header fw-bold">Thông tin cá nhân</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Input.FullName" class="form-control" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Bio" class="form-label">Giới thiệu bản thân</label>
                            <textarea asp-for="Input.Bio" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DateOfBirth" class="form-label">Ngày sinh</label>
                                <input asp-for="Input.DateOfBirth" class="form-control" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Gender" class="form-label">Giới tính</label>
                                <select asp-for="Input.Gender" class="form-select">
                                    <option value="">-- Chọn --</option>
                                    <option value="Male">Nam</option>
                                    <option value="Female">Nữ</option>
                                    <option value="Other">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.PreferredWorkCommuneCode" class="form-label">
                                Mã xã/phường làm việc
                            </label>
                            <input asp-for="Input.PreferredWorkCommuneCode" class="form-control" />
                        </div>
                        @* <div>
                        <select asp-for="Input.ProvinceCode" class="form-select" id="provinceSelect">
                            <option value="">-- Chọn Tỉnh/Thành phố --</option>
                            @foreach (var p in Model.Provinces)
                            {
                                <option value="@p.Code">@p.Name</option>
                            }
                        </select>
                        </div>
                        <div>
                        <select asp-for="Input.PreferredWorkCommuneCode" class="form-select" id="communeSelect">
                            <option value="">-- Chọn Xã/Phường --</option>
                            @foreach (var c in Model.Communes)
                            {
                                <option value="@c.Code">@c.Name</option>
                            }
                        </select>
                        </div> *@
                    

                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-page="/Candidate/CandidateSchedule/EditSchedule">Thời gian rảnh của tôi</a>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* <script>
        document.getElementById('provinceSelect').addEventListener('change', async function () {
            const code = this.value;
            const select = document.getElementById('communeSelect');
            select.innerHTML = '<option value="">-- Đang tải... --</option>';
