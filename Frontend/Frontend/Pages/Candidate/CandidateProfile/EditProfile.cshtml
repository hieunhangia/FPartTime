@page
@model EditProfileModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h2 class="mb-3">Chỉnh sửa hồ sơ</h2>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @if (!Model.IsOpenForJob)
            {
                <div class="card border-warning bg-warning bg-opacity-10 mb-4 shadow-sm">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                                <h5 class="mb-0 fw-bold text-dark">Bạn đang tắt trạng thái tìm việc!</h5>
                            </div>
                            <p class="mb-1 text-secondary">
                                Nhà tuyển dụng sẽ <strong>không thể tìm thấy hồ sơ của bạn</strong> và hệ thống sẽ <strong>tạm dừng gợi ý</strong> bạn cho các công việc phù hợp.
                            </p>
                            <small class="text-muted fst-italic">
                                <i class="bi bi-info-circle me-1"></i>Khi bật, trạng thái tìm việc sẽ được duy trì tự động trong vòng <strong>7 ngày</strong>.
                            </small>
                        </div>
                        <div class="text-nowrap">
                            <form method="post" asp-page-handler="ToggleOpenForJobStatus" asp-route-enable="true">
                                <button type="submit" class="btn btn-warning fw-bold text-dark px-3 py-2">
                                    <i class="bi bi-briefcase-fill me-1"></i> Bật tìm việc ngay (7 ngày)
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-success bg-success bg-opacity-10 mb-4 shadow-sm">
                    <div class="card-body d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                                <h5 class="mb-0 fw-bold text-success">Bạn đang ở trạng thái: Sẵn sàng tìm việc</h5>
                            </div>
                            <p class="mb-1 text-secondary">
                                Hồ sơ của bạn đang được ưu tiên hiển thị cho các nhà tuyển dụng và hệ thống gợi ý việc làm.
                            </p>
                            <div class="text-muted small">
                                <i class="bi bi-clock-history me-1"></i>Hiệu lực đến:
                                <strong class="text-dark">@Model.OpenForJobUntil?.ToLocalTime().ToString("HH:mm - dd/MM/yyyy")</strong>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-nowrap">
                            @if (Model.CanRefresh)
                            {
                                <form method="post" asp-page-handler="ToggleOpenForJobStatus" asp-route-enable="true" class="d-inline">
                                    <button type="submit" class="btn btn-outline-success btn-sm fw-semibold">
                                        <i class="bi bi-arrow-repeat me-1"></i> Làm mới (7 ngày)
                                    </button>
                                </form>
                            }
                            <form method="post" asp-page-handler="ToggleOpenForJobStatus" asp-route-enable="false" class="d-inline"
                                  onsubmit="return confirm('Bạn có chắc chắn muốn tắt trạng thái tìm việc? Nhà tuyển dụng sẽ không tìm thấy bạn.');">
                                <button type="submit" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-power me-1"></i> Tắt tìm việc
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }

            <form method="post" enctype="multipart/form-data">
                <div class="card mb-4">
                    <div class="card-header fw-bold">Ảnh đại diện</div>
                    <div class="card-body">
                        @if (!string.IsNullOrEmpty(Model.CurrentAvatarUrl))
                        {
                            <img src="@Model.CurrentAvatarUrl" class="rounded-circle mb-3"
                                 style="width:80px;height:80px;object-fit:cover;" alt="Avatar" />
                        }
                        <div class="mb-3">
                            <label asp-for="Input.AvatarFile" class="form-label">Chọn ảnh mới</label>
                            <input asp-for="Input.AvatarFile" class="form-control" accept=".jpg,.jpeg,.png" />
                            <div class="form-text">JPG, JPEG hoặc PNG. Tối đa 5MB.</div>
                            <span asp-validation-for="Input.AvatarFile" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header fw-bold">Thông tin cá nhân</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Input.FullName" class="form-control" />
                            <span asp-validation-for="Input.FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.Bio" class="form-label">Giới thiệu bản thân</label>
                            <textarea asp-for="Input.Bio" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.DateOfBirth" class="form-label">Ngày sinh</label>
                                <input asp-for="Input.DateOfBirth" class="form-control" />
                                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Input.Gender" class="form-label">Giới tính</label>
                                <select asp-for="Input.Gender" class="form-select">
                                    <option value="">-- Chọn --</option>
                                    <option value="Male">Nam</option>
                                    <option value="Female">Nữ</option>
                                    <option value="Other">Khác</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Input.PreferredWorkCommuneCode" class="form-label">
                                Mã xã/phường làm việc
                            </label>
                            <input asp-for="Input.PreferredWorkCommuneCode" class="form-control" />
                        </div>
                        @* <div>
                        <select asp-for="Input.ProvinceCode" class="form-select" id="provinceSelect">
                            <option value="">-- Chọn Tỉnh/Thành phố --</option>
                            @foreach (var p in Model.Provinces)
                            {
                                <option value="@p.Code">@p.Name</option>
                            }
                        </select>
                        </div>
                        <div>
                        <select asp-for="Input.PreferredWorkCommuneCode" class="form-select" id="communeSelect">
                            <option value="">-- Chọn Xã/Phường --</option>
                            @foreach (var c in Model.Communes)
                            {
                                <option value="@c.Code">@c.Name</option>
                            }
                        </select>
                        </div> *@
                    

                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div>
    <a asp-page="/Candidate/CandidateSchedule/EditSchedule">Thời gian rảnh của tôi</a>
</div>


