@page
@model Frontend.Pages.Employer.MyRegistrationsModel
@{
    ViewData["Title"] = "Yêu cầu đăng ký nhà tuyển dụng của tôi";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Yêu cầu đăng ký nhà tuyển dụng của tôi</h2>
        <a asp-page="Register" class="btn btn-primary">Gửi yêu cầu mới</a>
    </div>

    @if (Model.Registrations.Count == 0)
    {
        <div class="alert alert-light border text-center py-5" role="alert">
            <p class="mb-3">Bạn chưa gửi yêu cầu đăng ký trở thành nhà tuyển dụng nào.</p>
            <a asp-page="Register" class="btn btn-outline-primary">Gửi yêu cầu ngay</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên công ty</th>
                        <th>Trạng thái</th>
                        <th>Ngày gửi</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var registration in Model.Registrations)
                    {
                        var (statusLabel, statusCss) = Model.GetStatusDisplay(registration.Status);
                        <tr>
                            <td>@registration.CompanyName</td>
                            <td><span class="badge @statusCss">@statusLabel</span></td>
                            <td>@registration.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-"</td>
                            <td class="text-end">
                                @if (registration.Id is not null)
                                {
                                    <a asp-page="MyRegistrationDetail" asp-route-id="@registration.Id"
                                       class="btn btn-sm btn-outline-primary">Xem chi tiết</a>
                                    
                                    @if (registration.Status == "Pending")
                                    {
                                        <form method="post" asp-page-handler="Cancel" asp-route-id="@registration.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn hủy yêu cầu này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger ms-1">Hủy</button>
                                        </form>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
