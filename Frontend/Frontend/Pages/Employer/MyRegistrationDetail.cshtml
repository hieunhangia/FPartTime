@page "{id:guid}"
@model Frontend.Pages.Employer.MyRegistrationDetailModel
@{
    ViewData["Title"] = "Chi tiết yêu cầu đăng ký nhà tuyển dụng";
    var registration = Model.Registration!;
    var (statusLabel, statusCss) = Model.GetStatusDisplay(registration.Status);
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Chi tiết yêu cầu đăng ký</h2>
        <a asp-page="MyRegistrations" class="btn btn-outline-secondary">&larr; Quay lại danh sách</a>
    </div>

    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h4 class="mb-1">@registration.CompanyName</h4>
                <div class="text-muted">Gửi lúc @Model.FormatDateTime(registration.CreatedAt)</div>
            </div>
            <span class="badge @statusCss fs-6">@statusLabel</span>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-bold">Thông tin doanh nghiệp</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Tên công ty</dt>
                <dd class="col-sm-8">@registration.CompanyName</dd>

                <dt class="col-sm-4">Mã số thuế</dt>
                <dd class="col-sm-8">@registration.TaxCode</dd>

                <dt class="col-sm-4">Tài liệu xác thực doanh nghiệp</dt>
                <dd class="col-sm-8">
                    @if (!string.IsNullOrWhiteSpace(registration.DocumentUrl))
                    {
                        <div class="mb-2">
                            <img src="@registration.DocumentUrl" alt="Tài liệu xác thực doanh nghiệp" class="img-fluid rounded border" style="max-height: 300px" />
                        </div>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-bold">Thông tin người đại diện</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Họ và tên</dt>
                <dd class="col-sm-8">@registration.FullName</dd>

                <dt class="col-sm-4">Ngày sinh</dt>
                <dd class="col-sm-8">@Model.FormatDate(registration.DateOfBirth)</dd>

                <dt class="col-sm-4">Số điện thoại</dt>
                <dd class="col-sm-8">@registration.PhoneNumber</dd>

                <dt class="col-sm-4">Số CCCD</dt>
                <dd class="col-sm-8">@registration.CccdNumber</dd>
            </dl>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-bold">Ảnh CCCD</div>
        <div class="card-body">
            <div class="row g-3">
                @if (!string.IsNullOrWhiteSpace(registration.CccdFrontImageUrl))
                {
                    <div class="col-md-6">
                        <label class="form-label">Mặt trước</label>
                        <img src="@registration.CccdFrontImageUrl" alt="Ảnh CCCD mặt trước" class="img-fluid rounded border" />
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(registration.CccdBackImageUrl))
                {
                    <div class="col-md-6">
                        <label class="form-label">Mặt sau</label>
                        <img src="@registration.CccdBackImageUrl" alt="Ảnh CCCD mặt sau" class="img-fluid rounded border" />
                    </div>
                }
                @if (string.IsNullOrWhiteSpace(registration.CccdFrontImageUrl) &&
                     string.IsNullOrWhiteSpace(registration.CccdBackImageUrl))
                {
                    <div class="col-12 text-muted">Không có ảnh CCCD.</div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header fw-bold">Trạng thái xử lý</div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Trạng thái</dt>
                <dd class="col-sm-8"><span class="badge @statusCss">@statusLabel</span></dd>

                <dt class="col-sm-4">Ngày gửi</dt>
                <dd class="col-sm-8">@Model.FormatDateTime(registration.CreatedAt)</dd>

                <dt class="col-sm-4">Ngày xử lý</dt>
                <dd class="col-sm-8">@Model.FormatDateTime(registration.ProcessedAt)</dd>

                @if (!string.IsNullOrWhiteSpace(registration.RejectReason))
                {
                    <dt class="col-sm-4">Lý do từ chối</dt>
                    <dd class="col-sm-8 text-danger">@registration.RejectReason</dd>
                }
            </dl>
        </div>
    </div>
</div>
