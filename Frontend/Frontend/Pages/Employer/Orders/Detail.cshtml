@page "{id:guid}"
@using ApiSdk.Models
@model Frontend.Pages.Employer.Orders.DetailModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Chi tiết đơn hàng</h2>
            @if (Model.Order != null)
            {
                var (statusLabel, statusCss) = Model.GetOrderStatusDisplay(Model.Order.Status);
                <span class="badge @statusCss">@statusLabel</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                &larr; Quay lại danh sách
            </a>
            @if (Model.Order?.Status == OrderStatus.PendingPayment)
            {
                <form method="post" asp-page-handler="CancelOrder" asp-route-id="@Model.Order.Id"
                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy đơn hàng này? Toàn bộ các giao dịch đang chờ liên quan sẽ bị hủy.');">
                    <button type="submit" class="btn btn-outline-danger">
                        Hủy đơn hàng
                    </button>
                </form>
            }
        </div>
    </div>

    @if (Model.Order != null)
    {
        <!-- Thông tin tổng quan đơn hàng -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light fw-bold">
                Thông tin đơn hàng
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Mã đơn hàng:</label>
                        <div class="font-monospace fw-bold">@Model.Order.Id</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Tổng tiền thanh toán:</label>
                        <div class="fs-5 text-primary fw-bold">@(Model.Order.TotalAmount?.ToString("N0") ?? "0") đ</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Mô tả nội dung:</label>
                        <div>@Model.Order.Description</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Trạng thái:</label>
                        <div>
                            @{
                                var (statusLabel, statusCss) = Model.GetOrderStatusDisplay(Model.Order.Status);
                            }
                            <span class="badge @statusCss">@statusLabel</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Thời gian tạo đơn:</label>
                        <div>@(Model.Order.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Thời gian hoàn thành:</label>
                        <div>@(Model.Order.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small mb-1">Thời hạn thanh toán:</label>
                        <div>
                            @(Model.Order.ExpiredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "-")
                            @if (Model.Order.Status == OrderStatus.PendingPayment && Model.Order.ExpiredAt <= DateTimeOffset.UtcNow)
                            {
                                <span class="badge bg-danger ms-1">Đã quá hạn</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Danh sách giao dịch thanh toán -->
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-bold">Lịch sử giao dịch thanh toán (@(Model.Order.PaymentTransactions?.Count ?? 0))</span>
            </div>
            <div class="card-body p-0">
                @if (Model.Order.PaymentTransactions == null || Model.Order.PaymentTransactions.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        Chưa có giao dịch thanh toán nào cho đơn hàng này.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã giao dịch</th>
                                    <th>Cổng thanh toán</th>
                                    <th>Số tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Thời gian tạo</th>
                                    <th>Hạn thanh toán</th>
                                    <th>Thời gian trả</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tx in Model.Order.PaymentTransactions)
                                {
                                    var (txStatusLabel, txStatusCss) = Model.GetTransactionStatusDisplay(tx.Status);
                                    var shortTxId = tx.Id?.ToString()[..8];
                                    <tr>
                                        <td>
                                            <span class="font-monospace small" title="@tx.Id">#@shortTxId</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold">@tx.Provider</span>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@(tx.Amount?.ToString("N0") ?? "0") đ</span>
                                        </td>
                                        <td>
                                            @if (Model.IsTransactionExpired(tx))
                                            {
                                                <span class="badge bg-danger">Hết hạn</span>
                                            }
                                            else
                                            {
                                                <span class="badge @txStatusCss">@txStatusLabel</span>
                                            }
                                        </td>
                                        <td class="small">
                                            @(tx.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                                        </td>
                                        <td class="small">
                                            @(tx.ExpiredAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                                        </td>
                                        <td class="small">
                                            @(tx.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (Model.CanPayNow(tx))
                                            {
                                                <a href="@tx.PaymentUrl" class="btn btn-sm btn-success me-1">
                                                    Thanh toán ngay
                                                </a>
                                            }

                                            @if (tx.Status == PaymentTransactionStatus.Pending)
                                            {
                                                <form method="post" asp-page-handler="CancelTransaction"
                                                      asp-route-transactionId="@tx.Id" asp-route-id="@Model.Order.Id"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc chắn muốn hủy giao dịch thanh toán này?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        Hủy
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.Order.Status == OrderStatus.Expired)
            {
                <div class="card-footer bg-white border-top">
                    <div class="alert alert-danger mb-0 py-2 small" role="alert">
                        Đơn hàng này đã quá thời hạn thanh toán và đã hết hạn. Bạn có thể tạo đơn hàng mới tại trang <a asp-page="/Employer/Subscriptions/Index" class="alert-link">Gói dịch vụ</a>.
                    </div>
                </div>
            }
            else if (Model.Order.Status == OrderStatus.PendingPayment && (!Model.Order.PaymentTransactions?.Any(t => t.Status == PaymentTransactionStatus.Pending) ?? true))
            {
                <div class="card-footer bg-white border-top">
                    <div class="alert alert-warning mb-0 py-2 small" role="alert">
                        Đơn hàng hiện không có giao dịch thanh toán nào đang chờ. Nếu giao dịch trước đó đã hết hạn hoặc bị hủy, bạn vui lòng hủy đơn hàng này và thực hiện đăng ký gói mới tại trang <a asp-page="/Employer/Subscriptions/Index" class="alert-link">Gói dịch vụ</a>.
                    </div>
                </div>
            }
        </div>
    }
</div>
