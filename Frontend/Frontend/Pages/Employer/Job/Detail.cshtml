@page "{id:guid}"
@model Frontend.Pages.Employer.Job.DetailModel
@{
    ViewData["Title"] = "Chi tiết công việc";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Chi tiết công việc</h2>
            @if (Model.Job != null)
            {
                var (statusLabel, statusCss) = Model.GetStatusDisplay(Model.Job.Status);
                <span class="badge @statusCss">@statusLabel</span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (Model.Job?.Status == ApiSdk.Models.JobStatus.Active)
            {
                <form method="post" asp-page-handler="CloseJob" asp-route-id="@Model.Job.Id"
                      onsubmit="return confirm('Bạn có chắc chắn muốn đóng bài đăng này? Sau khi đóng, bài đăng sẽ không nhận thêm hồ sơ.');">
                    <button type="submit" class="btn btn-outline-danger">Đóng bài đăng</button>
                </form>
            }
            @if (Model.Job?.Status == ApiSdk.Models.JobStatus.Closed)
            {
                <form method="post" asp-page-handler="ReopenJob" asp-route-id="@Model.Job.Id"
                      onsubmit="return confirm('Bạn có chắc chắn muốn mở lại bài đăng này? Sau khi mở lại, ứng viên có thể tiếp tục nộp hồ sơ.');">
                    <button type="submit" class="btn btn-outline-success">Mở lại bài đăng</button>
                </form>
            }
            <a asp-page="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
        </div>
    </div>

    @if (Model.Job != null)
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Mô tả công việc</h5>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(Model.Job.Description))
                        {
                            <div style="white-space: pre-line;">@Model.Job.Description</div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Chưa có thông tin mô tả chi tiết.</p>
                        }
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Lịch làm việc</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Job.JobSchedules != null && Model.Job.JobSchedules.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Thứ trong tuần</th>
                                        <th>Giờ bắt đầu</th>
                                        <th>Giờ kết thúc</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var schedule in Model.Job.JobSchedules)
                                    {
                                        <tr>
                                            <td>@Model.GetDayOfWeekDisplay(schedule.DayOfWeek)</td>
                                            <td>@Model.FormatTime(schedule.StartTime)</td>
                                            <td>@Model.FormatTime(schedule.EndTime)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Không có lịch làm việc cố định.</p>
                        }
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Danh sách ứng viên ứng tuyển</h5>
                        <span class="badge bg-primary">@(Model.Job.JobApplications?.Count ?? 0) ứng viên</span>
                    </div>
                    <div class="card-body">
                        @if (Model.Job.JobApplications != null && Model.Job.JobApplications.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Họ và tên ứng viên</th>
                                        <th>Số điện thoại</th>
                                        <th>Ngày nộp đơn</th>
                                        <th>Trạng thái đơn</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var app in Model.Job.JobApplications)
                                    {
                                        var (appStatusLabel, appStatusCss) = Model.GetApplicationStatusDisplay(app.Status);
                                        <tr>
                                            <td>@(app.CandidateFullName ?? "-")</td>
                                            <td>@(app.CandidatePhoneNumber ?? "-")</td>
                                            <td>@(app.AppliedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                                            <td><span class="badge @appStatusCss">@appStatusLabel</span></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Chưa có ứng viên nào nộp hồ sơ cho công việc này.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Thông tin chung</h5>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Tiêu đề</dt>
                            <dd class="col-sm-7 fw-bold">@Model.Job.Title</dd>

                            <dt class="col-sm-5">Ngành nghề</dt>
                            <dd class="col-sm-7">@(Model.Job.IndustryName ?? "-")</dd>

                            <dt class="col-sm-5">Số lượng tuyển</dt>
                            <dd class="col-sm-7">@(Model.Job.VacancyCount.HasValue ? $"{Model.Job.VacancyCount} người" : "Không giới hạn")</dd>

                            <dt class="col-sm-5">Giới tính</dt>
                            <dd class="col-sm-7">@Model.GetGenderDisplay(Model.Job.GenderRequirement)</dd>

                            <dt class="col-sm-5">Độ tuổi</dt>
                            <dd class="col-sm-7">
                                @if (Model.Job.MinAgeRequirement.HasValue && Model.Job.MaxAgeRequirement.HasValue)
                                {
                                    <span>Từ @Model.Job.MinAgeRequirement đến @Model.Job.MaxAgeRequirement tuổi</span>
                                }
                                else if (Model.Job.MinAgeRequirement.HasValue)
                                {
                                    <span>Từ @Model.Job.MinAgeRequirement tuổi</span>
                                }
                                else if (Model.Job.MaxAgeRequirement.HasValue)
                                {
                                    <span>Đến @Model.Job.MaxAgeRequirement tuổi</span>
                                }
                                else
                                {
                                    <span>Không yêu cầu</span>
                                }
                            </dd>

                            <dt class="col-sm-5">Địa chỉ</dt>
                            <dd class="col-sm-7">
                                @{
                                    var fullAddress = string.Join(", ", new[] { Model.Job.DetailAddress, Model.Job.CommuneName, Model.Job.ProvinceName }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                }
                                @(string.IsNullOrWhiteSpace(fullAddress) ? "-" : fullAddress)
                            </dd>

                            <dt class="col-sm-5">Ngày tạo</dt>
                            <dd class="col-sm-7">@(Model.Job.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

                            <dt class="col-sm-5">Hạn nộp</dt>
                            <dd class="col-sm-7">@Model.FormatDate(Model.Job.ExpiryAt)</dd>
                        </dl>
                    </div>
                </div>

                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Mức lương</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.Job.JobSalaries is { Count: > 0 })
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var salary in Model.Job.JobSalaries)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                        <span>Theo @Model.FormatSalaryRate(salary.TimeQuantity, salary.TimeUnit)</span>
                                        <span
                                            class="fw-bold text-success">@Model.FormatSalaryAmount(salary.Amount)</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Thỏa thuận</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
