@page "{id:guid}"
@model Frontend.Pages.Employer.Job.ApplicationDetailModel
@{
    ViewData["Title"] = "Chi tiết đơn ứng tuyển";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Chi tiết đơn ứng tuyển</h2>
            @if (Model.Application != null)
            {
                var (statusLabel, statusCss) = Model.GetApplicationStatusDisplay(Model.Application.Status);
                <span class="badge @statusCss fs-6">@statusLabel</span>
            }
        </div>
        <div>
            @if (Model.JobId.HasValue)
            {
                <a asp-page="Detail" asp-route-id="@Model.JobId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại chi tiết công việc
                </a>
            }
            else
            {
                <a asp-page="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Quay lại danh sách công việc
                </a>
            }
        </div>
    </div>

    @if (Model.Application != null)
    {
        <div class="row">
            <!-- Cột trái: Thông tin ứng viên & Lịch làm việc -->
            <div class="col-md-8">
                <!-- Thông tin cá nhân -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Thông tin ứng viên</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-4 mb-4 pb-3 border-bottom">
                            <div>
                                @if (!string.IsNullOrWhiteSpace(Model.Application.CandidateAvatarUrl))
                                {
                                    <img src="@Model.Application.CandidateAvatarUrl"
                                         alt="@Model.Application.CandidateFullName"
                                         class="rounded-circle border"
                                         style="width: 90px; height: 90px; object-fit: cover;"/>
                                }
                                else
                                {
                                    <div
                                        class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold fs-2 border border-primary border-opacity-25"
                                        style="width: 90px; height: 90px;">
                                        @(string.IsNullOrWhiteSpace(Model.Application.CandidateFullName) ? "?" : Model.Application.CandidateFullName.Trim().Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </div>
                            <div class="flex-grow-1">
                                <h4 class="mb-1 fw-bold text-dark">@(Model.Application.CandidateFullName ?? "Chưa cập nhật tên")</h4>
                                <div class="text-muted d-flex flex-wrap gap-3 mt-2">
                                    @if (!string.IsNullOrWhiteSpace(Model.Application.CandidatePhoneNumber))
                                    {
                                        <span>
                                            <i class="bi bi-telephone me-1"></i>
                                            <a href="tel:@Model.Application.CandidatePhoneNumber"
                                               class="text-decoration-none">
                                                @Model.Application.CandidatePhoneNumber
                                            </a>
                                        </span>
                                    }
                                    <span>
                                        <i class="bi bi-gender-ambiguous me-1"></i>
                                        @Model.GetGenderDisplay(Model.Application.CandidateGender)
                                    </span>
                                    @if (Model.Application.CandidateDateOfBirth.HasValue)
                                    {
                                        var age = Model.GetAge(Model.Application.CandidateDateOfBirth);
                                        <span>
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @Model.FormatDate(Model.Application.CandidateDateOfBirth)
                                            @(age.HasValue ? $"({age.Value} tuổi)" : "")
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Khu vực mong muốn</dt>
                            <dd class="col-sm-8">
                                @{
                                    var preferredLocation = string.Join(", ", new[] { Model.Application.CandidatePreferredWorkCommuneName, Model.Application.CandidatePreferredWorkProvinceName }.Where(s => !string.IsNullOrWhiteSpace(s)));
                                }
                                @(string.IsNullOrWhiteSpace(preferredLocation) ? "Không có yêu cầu khu vực cụ thể" : preferredLocation)
                            </dd>

                            <dt class="col-sm-4 text-muted mt-2">Giới thiệu bản thân</dt>
                            <dd class="col-sm-8 mt-2">
                                @if (!string.IsNullOrWhiteSpace(Model.Application.CandidateBio))
                                {
                                    <div class="p-3 bg-light rounded border text-secondary"
                                         style="white-space: pre-line;">
                                        @Model.Application.CandidateBio
                                    </div>
                                }
                                else
                                {
                                    <span
                                        class="text-muted fst-italic">Ứng viên chưa cung cấp lời giới thiệu bản thân.</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>

                <!-- Lịch làm việc mong muốn -->
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="card-title mb-0">Lịch làm việc mong muốn của ứng viên</h5>
                        <span
                            class="badge bg-secondary">@(Model.Application.CandidatePreferredWorkSchedules?.Count ?? 0) khung giờ</span>
                    </div>
                    <div class="card-body">
                        @if (Model.Application.CandidatePreferredWorkSchedules is { Count: > 0 })
                        {
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0 align-middle">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Thứ trong tuần</th>
                                        <th>Giờ bắt đầu</th>
                                        <th>Giờ kết thúc</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var schedule in Model.Application.CandidatePreferredWorkSchedules)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@Model.GetDayOfWeekDisplay(schedule.DayOfWeek)</td>
                                            <td>@Model.FormatTime(schedule.StartTime)</td>
                                            <td>@Model.FormatTime(schedule.EndTime)</td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Ứng viên không đăng ký khung giờ làm việc cố định (có thể sắp xếp
                                linh hoạt).</p>
                        }
                    </div>
                </div>
            </div>

            <!-- Cột phải: Trạng thái & Thao tác duyệt -->
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="card-title mb-0">Trạng thái & Thao tác</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="text-muted small d-block mb-1">Trạng thái hồ sơ</label>
                            @{
                                var (statusLabel, statusCss) = Model.GetApplicationStatusDisplay(Model.Application.Status);
                            }
                            <span class="badge @statusCss fs-6">@statusLabel</span>
                        </div>

                        <div class="mb-3">
                            <label class="text-muted small d-block mb-1">Thời điểm nộp đơn</label>
                            <span class="fw-semibold">
                                @(Model.Application.AppliedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")
                            </span>
                        </div>

                        <hr/>

                        @if (Model.Application.Status == ApiSdk.Models.JobApplicationStatus.Pending)
                        {
                            <div class="d-grid gap-2">
                                <form method="post" asp-page-handler="Accept" asp-route-id="@Model.Application.Id"
                                      asp-route-jobId="@Model.JobId"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn CHẤP NHẬN ứng viên này vào làm việc?');">
                                    <button type="submit" class="btn btn-success w-100">
                                        <i class="bi bi-check-circle me-1"></i> Chấp nhận đơn
                                    </button>
                                </form>

                                <form method="post" asp-page-handler="Reject" asp-route-id="@Model.Application.Id"
                                      asp-route-jobId="@Model.JobId"
                                      onsubmit="return confirm('Bạn có chắc chắn muốn TỪ CHỐI đơn ứng tuyển này?');">
                                    <button type="submit" class="btn btn-outline-danger w-100">
                                        <i class="bi bi-x-circle me-1"></i> Từ chối đơn
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
