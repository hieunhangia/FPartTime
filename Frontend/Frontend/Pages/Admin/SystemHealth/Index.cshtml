@page
@using Frontend.Services.Admin
@model Frontend.Pages.Admin.SystemHealth.IndexModel
@{
    ViewData["Title"] = "Sức khỏe hệ thống";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Sức khỏe hệ thống</h2>
        <a asp-page="./Index" asp-route-refresh="true" class="btn btn-outline-primary btn-sm">
            Làm mới
        </a>
    </div>

    @if (Model.HealthData != null)
    {
        @switch (Model.HealthData.OverallStatus)
        {
            case OverallStatus.Operational:
                <div class="alert alert-success mb-4" role="alert">
                    Tất cả dịch vụ đang hoạt động bình thường.
                </div>
                break;
            case OverallStatus.Outage:
                <div class="alert alert-danger mb-4" role="alert">
                    Có dịch vụ đang gặp sự cố ngừng hoạt động.
                </div>
                break;
            case OverallStatus.Degraded:
                <div class="alert alert-warning mb-4" role="alert">
                    Có dịch vụ đang hoạt động với hiệu năng suy giảm hoặc bảo trì.
                </div>
                break;
            default:
                <div class="alert alert-info mb-4" role="alert">
                    Không xác định
                </div>
                break;
        }

        <div class="row g-3 mb-4">
            <div class="col-6 col-md-3">
                <div class="card h-100 text-center stat-card">
                    <div class="card-body">
                        <div class="text-muted small">Tổng số dịch vụ</div>
                        <div class="fs-4 fw-bold text-dark mt-1 tabular-nums">@Model.HealthData.TotalMonitors</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100 text-center stat-card">
                    <div class="card-body">
                        <div class="text-muted small">Đang hoạt động</div>
                        <div class="fs-4 fw-bold text-success mt-1 tabular-nums">@Model.HealthData.UpMonitors</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100 text-center stat-card">
                    <div class="card-body">
                        <div class="text-muted small">Gặp sự cố</div>
                        <div class="fs-4 fw-bold text-danger mt-1 tabular-nums">@Model.HealthData.DownMonitors</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100 text-center stat-card">
                    <div class="card-body">
                        <div class="text-muted small">Tỷ lệ khả dụng</div>
                        <div class="fs-4 fw-bold text-primary mt-1 tabular-nums">
                            @(Model.HealthData.AverageSla.HasValue ? $"{Model.HealthData.AverageSla.Value}%" : "—")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-bold">Dịch vụ được theo dõi</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped align-middle mb-0">
                        <thead class="table-light">
                        <tr>
                            <th>Dịch vụ</th>
                            <th>URL</th>
                            <th>Trạng thái</th>
                            <th>Tỷ lệ khả dụng</th>
                            <th>Độ trễ</th>
                            <th>Lần kiểm tra cuối</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var monitor in Model.HealthData.Monitors)
                        {
                            <tr role="button"
                                onclick="location.href='@Url.Page("Detail", new { id = monitor.Id })'"
                                class="monitor-row">
                                <td><span class="fw-bold">@monitor.Name</span></td>
                                <td><small class="text-muted font-monospace">@monitor.Url</small></td>
                                <td><span class="badge @(monitor.Status switch
                                                       {
                                                           MonitorStatus.Up => "bg-success",
                                                           MonitorStatus.Down => "bg-danger",
                                                           MonitorStatus.Pending => "bg-warning text-dark",
                                                           MonitorStatus.Paused => "bg-secondary",
                                                           MonitorStatus.Validating => "bg-secondary",
                                                           MonitorStatus.Maintenance => "bg-warning text-dark",
                                                           _ => "bg-secondary"
                                                       })">@monitor.StatusText</span></td>
                                <td class="tabular-nums">@(monitor.SlaAvailability.HasValue ? $"{monitor.SlaAvailability.Value}%" : "—")</td>
                                <td class="tabular-nums">@(monitor.AvgResponseTimeMs.HasValue ? $"{monitor.AvgResponseTimeMs.Value} ms" : "—")</td>
                                <td class="tabular-nums">
                                    <small class="text-muted">
                                        @(monitor.LastCheckedAt.HasValue ? monitor.LastCheckedAt.Value.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy") : "—")
                                    </small>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0 fw-bold">Lịch sử sự cố</h6>
            </div>
            <div class="card-body p-0">
                @if (Model.HealthData.Incidents.Count == 0)
                {
                    <div class="p-3 text-muted text-center">Không có sự cố nào được ghi nhận.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-light">
                            <tr>
                                <th>Sự cố</th>
                                <th>URL</th>
                                <th>Nguyên nhân</th>
                                <th>Bắt đầu lúc</th>
                                <th>Khắc phục lúc</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var incident in Model.HealthData.Incidents)
                            {
                                <tr>
                                    <td><strong>@incident.Name</strong></td>
                                    <td><small class="text-muted font-monospace">@(incident.Url ?? "—")</small></td>
                                    <td><span class="text-danger small">@(incident.Cause ?? "—")</span></td>
                                    <td>
                                        <small>@(incident.StartedAt.HasValue ? incident.StartedAt.Value.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy") : "—")</small>
                                    </td>
                                    <td>
                                        <small>@(incident.ResolvedAt.HasValue ? incident.ResolvedAt.Value.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy") : "Chưa khắc phục")</small>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>
