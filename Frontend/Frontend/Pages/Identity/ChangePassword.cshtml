@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="auth-container">
    <h2 class="auth-title">Đổi mật khẩu</h2>
    <hr class="auth-divider"/>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

        <div class="form-group">
            <label asp-for="@Model.ChangePasswordForm.CurrentPassword" class="form-label"></label>
            <input asp-for="@Model.ChangePasswordForm.CurrentPassword" class="form-input" autofocus/>
            <span asp-validation-for="@Model.ChangePasswordForm.CurrentPassword" class="form-text-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="@Model.ChangePasswordForm.NewPassword" class="form-label"></label>
            <input asp-for="@Model.ChangePasswordForm.NewPassword" class="form-input"/>
            <span asp-validation-for="@Model.ChangePasswordForm.NewPassword" class="form-text-error"></span>
            <small class="form-help-text">(Tối thiểu 6 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường, 1 số và 1 ký tự đặc
                biệt)</small>
        </div>

        <div class="form-group">
            <label asp-for="@Model.ChangePasswordForm.ConfirmPassword" class="form-label"></label>
            <input asp-for="@Model.ChangePasswordForm.ConfirmPassword" class="form-input"/>
            <span asp-validation-for="@Model.ChangePasswordForm.ConfirmPassword" class="form-text-error"></span>
        </div>

        <button type="submit" class="btn-submit">Đổi mật khẩu</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
