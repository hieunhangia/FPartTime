@page
@model LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="auth-container">
    <h2 class="auth-title">Đăng nhập</h2>
    <hr class="auth-divider" />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="auth-alert-error">
            @Model.ErrorMessage
        </div>
    }

    <form method="post">
        <input type="hidden" asp-for="@Model.LoginForm.PhoneNumber" />
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

        <p class="phone-display-row">
            Số điện thoại: <strong>@Model.LoginForm.PhoneNumber</strong>
            <a asp-page="LoginOrRegister" class="change-phone-link">[Thay đổi SĐT]</a>
        </p>

        <div class="form-group">
            <label asp-for="@Model.LoginForm.Password" class="form-label"></label>
            <input asp-for="@Model.LoginForm.Password" class="form-input" autofocus />
            <span asp-validation-for="@Model.LoginForm.Password" class="form-text-error"></span>
        </div>

        <button type="submit" class="btn-submit">Đăng nhập</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
