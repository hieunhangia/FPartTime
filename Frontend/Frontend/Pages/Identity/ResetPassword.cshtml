@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<div class="auth-container">
    <h2 class="auth-title">Đặt lại mật khẩu</h2>
    <hr class="auth-divider"/>

    <form method="post">
        <input type="hidden" asp-for="@Model.ResetPasswordForm.PhoneNumber"/>
        <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

        <p class="phone-display-row">
            Số điện thoại: <strong>@Model.ResetPasswordForm.PhoneNumber</strong>
            <a asp-page="LoginOrRegister" class="change-phone-link">[Thay đổi SĐT]</a>
        </p>

        <div class="form-group">
            <label asp-for="@Model.ResetPasswordForm.NewPassword" class="form-label"></label>
            <input asp-for="@Model.ResetPasswordForm.NewPassword" class="form-input" autofocus/>
            <span asp-validation-for="@Model.ResetPasswordForm.NewPassword" class="form-text-error"></span>
            <small class="form-help-text">(Tối thiểu 6 ký tự, gồm ít nhất 1 chữ hoa, 1 chữ thường, 1 số và 1 ký tự đặc
                biệt)</small>
        </div>

        <div class="form-group">
            <label asp-for="@Model.ResetPasswordForm.ConfirmPassword" class="form-label"></label>
            <input asp-for="@Model.ResetPasswordForm.ConfirmPassword" class="form-input"/>
            <span asp-validation-for="@Model.ResetPasswordForm.ConfirmPassword" class="form-text-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="@Model.ResetPasswordForm.Otp" class="form-label"></label>
            <div class="otp-group">
                <input asp-for="@Model.ResetPasswordForm.Otp" maxlength="6" class="otp-input" placeholder="6 chữ số"/>
                <button type="button" id="btnSendOtp" class="btn-otp">Gửi OTP</button>
            </div>
            <span asp-validation-for="@Model.ResetPasswordForm.Otp" class="form-text-error"></span>
        </div>

        <button type="submit" class="btn-submit">Đặt lại mật khẩu</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
    <script src="~/js/otp.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            initOtpHandler({
                btnId: 'btnSendOtp',
                handlerUrl: '?handler=SendOtp',
                cooldownSeconds: 60
            });
        });
    </script>
}
